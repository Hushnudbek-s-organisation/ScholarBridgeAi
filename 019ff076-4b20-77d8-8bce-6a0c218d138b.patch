+  console.log("\n=== TEST 2: snake_case rows (raw SQL shape) ===");
+  const snakeRow = {
+    name: "Imperial College London",
+    official_website_url: "https://www.imperial.ac.uk/",
+    website_url: "https://www.imperial.ac.uk/",
