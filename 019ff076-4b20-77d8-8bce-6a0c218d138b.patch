+              <p className="text-xs font-extrabold text-slate-800">Admin sign-in</p>
+              <span className="inline-flex items-center gap-0.5 rounded-full bg-slate-900 px-1.5 py-0.5 text-[9px] font-bold text-white ml-auto">
