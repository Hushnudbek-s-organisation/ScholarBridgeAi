+                  <CheckCircle2 className="h-2.5 w-2.5" /> Official source
+                </span>
+                <ExternalLink className="h-3.5 w-3.5 text-slate-400 shrink-0" />
+              </a>
+            );
+          })()}
+
+          {/* Other admissions URLs as sources */}
