# ===========================================================================
# ScholarBridge — environment variables
# Copy to .env.local (dev) or set them in your host's dashboard (production).
# NEVER commit real values. Everything here is read on the SERVER only,
# except variables prefixed NEXT_PUBLIC_ (those are inlined into the browser
# bundle — never put a secret in a NEXT_PUBLIC_ variable).
# Full reference with required/secret flags: DEPLOYMENT.md → "Environment".
# ===========================================================================

# --- Core (required) --------------------------------------------------------
# PostgreSQL connection string (Supabase: Project settings → Database →
# Connection string, "Session pooler" or direct). SECRET.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Signs the HttpOnly session cookie `sb_session`. REQUIRED in production,
# >= 32 random characters. Rotating it signs everyone out. SECRET.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Canonical public URL of THIS deployment (https, no trailing slash). Used for
# Telegram buttons, the Mini App, referral links, sitemap/robots and
# OpenGraph. When unset the app falls back to NEXT_PUBLIC_APP_URL, then the
# host-provided RENDER_EXTERNAL_URL / VERCEL_PROJECT_PRODUCTION_URL. Nothing
# is hardcoded — moving hosts only means changing this value.
APP_URL=
# NEXT_PUBLIC_APP_URL=

# --- Admin + platform ownership ---------------------------------------------
# Bootstrap admin. The seed creates/promotes this account ONLY while no
# platform owner exists; after an ownership transfer it never re-promotes or
# renames anyone. ADMIN_PASSWORD (>= 8 chars, SECRET) is applied only while
# the account has no password.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: which admin becomes the platform owner on first start (defaults
# to ADMIN_EMAIL, else the oldest admin). Ignored once an owner exists —
# later changes go through Admin → Ownership.
# PLATFORM_OWNER_EMAIL=
# Hours an ownership transfer stays open (1–168, default 72).
# OWNERSHIP_TRANSFER_TTL_HOURS=72

# --- AI providers -------------------------------------------------------------
# Admins pick provider + model per task in Admin → AI Settings; keys saved
# there are AES-256-GCM encrypted in `ai_provider_credentials`. A key saved in
# the panel takes precedence; the env key is used when the panel has none.
# Encryption secret for panel-stored keys (>= 16 chars). SECRET.
AI_KEYS_ENCRYPTION_SECRET=
# During a rotation: the old secret, so existing keys still decrypt.
# AI_KEYS_ENCRYPTION_SECRET_PREVIOUS=
# Provider ids: openrouter | openai | anthropic | groq | google | custom
# (gemini = voice/Live only). Default provider and optional per-task override:
# AI_PROVIDER_<TASK> with TASK = ADMISSIONS | ESSAY | GENERAL | SEARCH | DOCUMENT_ANALYSIS | VISA
# AI_PROVIDER_DEFAULT=
# AI_PROVIDER_ESSAY=
# Explicit fallback when the chosen provider fails (off unless set):
# AI_PROVIDER_FALLBACK=
# Comma-separated providers that must never be used:
# AI_PROVIDERS_DISABLED=
# Keys (SECRET) + optional model overrides — set only the ones you use.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# GOOGLE_AI_API_KEY=
# GOOGLE_AI_MODEL=
# Any OpenAI-compatible endpoint (self-hosted / local / other vendor):
# AI_CUSTOM_BASE_URL=
# AI_CUSTOM_API_KEY=
# AI_CUSTOM_MODEL=
# Extra capabilities to declare for it, comma-separated (text is implied):
# AI_CUSTOM_CAPABILITIES=structured,tools
# Visa Speaking Assistant voice (Gemini Live):
# GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=
# GEMINI_LIVE_API_VERSION=
# OpenRouter attribution headers (default: APP_URL / "ScholarBridge"):
# OPENROUTER_SITE_URL=
# OPENROUTER_APP_NAME=

# --- Research agent: optional web-search fallback -------------------------------
# RESEARCH_SEARCH_ENDPOINT=
# RESEARCH_SEARCH_API_KEY=

# --- Telegram bot + Mini App ------------------------------------------------------
# Easiest: leave empty and paste the token in Admin → Telegram bot (stored
# encrypted). A token saved in the panel takes precedence over this one. SECRET.
# TELEGRAM_BOT_TOKEN=
# Webhook secret (16–256 chars of A-Z a-z 0-9 _ -). Default: derived from
# SESSION_SECRET + bot id. SECRET.
# TELEGRAM_WEBHOOK_SECRET=
# "Connect Telegram" link lifetime, seconds (60–900, default 600).
# TELEGRAM_LINK_TTL_SECONDS=600
# Max age of the Mini App's signed initData, seconds (default 3600).
# TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
# Mini App address (https). Default: <APP_URL>/tg
# TELEGRAM_MINI_APP_URL=
# Dev/tests only: point the bot at the local mock (node scripts/telegram-mock.mjs).
# TELEGRAM_API_BASE=http://127.0.0.1:8099

# --- Supabase Storage (branding uploads only) -------------------------------------
# Server-side only. Without these, logo/favicon upload answers 503 and the
# default images stay. The bucket must exist and be public-read.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BRANDING_BUCKET=LOGO
# Only for the /universities and /scholarships SSR pages when no service key:
# SUPABASE_ANON_KEY=

# --- Search engines ---------------------------------------------------------------
# Google Search Console HTML-tag token (content of the meta tag). Public.
# GOOGLE_SITE_VERIFICATION=

# --- Payments (Payme / Click) — only if you configure real merchants. SECRET. ---
# PAYME_MERCHANT_ID=
# PAYME_KEY=
# PAYME_PASSWORD=
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_MERCHANT_USER_ID=
# CLICK_SECRET_KEY=

# --- Scheduled jobs + reminders ---------------------------------------------------
# Bearer token for GET /api/cron/refresh and /api/cron/notifications. When
# unset those endpoints refuse to run (503). SECRET.
# CRON_SECRET=
# IANA timezone deciding what "today" is for reminders (default UTC).
# REMINDER_TIMEZONE=Asia/Tashkent
# In-process reminder scheduler: on | off (default: on in production).
# NOTIFICATION_SCHEDULER=
# Hours between reminder sweeps (0.25–24, default 3).
# NOTIFICATION_SWEEP_HOURS=3

# --- Security / proxy --------------------------------------------------------------
# Proxies appending to X-Forwarded-For (default 1) and an optional header set
# by your edge that clients cannot forge (e.g. cf-connecting-ip).
# TRUSTED_PROXY_HOPS=1
# CLIENT_IP_HEADER=
# Ship the CSP in report-only mode while testing.
# CSP_REPORT_ONLY=1
