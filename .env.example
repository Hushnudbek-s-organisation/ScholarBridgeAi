# ===========================================================================
# ScholarBridge — environment variables
# Copy to .env.local (dev) or set them in your host's dashboard (production).
# NEVER commit real values. Everything here is read on the SERVER only,
# except variables prefixed NEXT_PUBLIC_ (those are inlined into the browser
# bundle — never put a secret in a NEXT_PUBLIC_ variable).
# Full reference with required/secret flags: DEPLOYMENT.md → "Environment".
# ===========================================================================

# --- Core (required) --------------------------------------------------------
# PostgreSQL connection string (Supabase: Project settings → Database →
# Connection string, "Session pooler" or direct). SECRET.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- Database performance (all optional, see docs/BACKEND_PERFORMANCE.md) ----
# Connections this instance may hold. Keep PG_POOL_MAX × instances below the
# provider's limit; lower it to 2–3 behind a small pooler.
#PG_POOL_MAX=10
#PG_IDLE_TIMEOUT_MS=30000
#PG_CONNECT_TIMEOUT_MS=8000
#PG_MAX_USES=7500
#PG_MAX_LIFETIME_S=1800
#PG_QUERY_TIMEOUT_MS=20000
#PG_RETRY_ATTEMPTS=2
#PG_RETRY_BASE_MS=120
# Catalogue snapshot TTL (ms) — 5 min by default.
#CATALOG_CACHE_TTL_MS=300000

# Schema repair from a web request. "off" (recommended in production) means a
# request only VERIFIES tables; apply DDL with `npm run db:schema`, `npm run
# db:seed`, or Admin → Diagnostics → Retry. Unset = "auto" (repair once per
# process on first use).
#SCHEMA_AUTO_REPAIR=off
# Seeding from a web request: "auto" = dev/test only, "on"/"off" force it.
# The CLI seeder and the admin seed buttons always work.
#SEED_ON_REQUEST=auto

# Signs the HttpOnly session cookie `sb_session`. REQUIRED in production,
# >= 32 random characters. Rotating it signs everyone out. SECRET.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Session cookie SameSite mode. Leave unset for a normally hosted app: the
# cookie is HttpOnly + SameSite=Lax. Set to 1 ONLY when the app itself runs
# inside a third-party iframe (embedded preview, Mini App shell) — there a Lax
# cookie is never sent back, so sign-in returns 200 and the next session check
# returns 401. This mode issues `SameSite=None; Secure; Partitioned` (CHIPS):
# usable in an iframe, still isolated per top-level site.
# SESSION_COOKIE_CROSS_SITE=1

# Canonical public URL of THIS deployment (https, no trailing slash). Used for
# Telegram buttons, the Mini App, referral links, sitemap/robots and
# OpenGraph. When unset the app falls back to NEXT_PUBLIC_APP_URL, then the
# host-provided RENDER_EXTERNAL_URL / VERCEL_PROJECT_PRODUCTION_URL. Nothing
# is hardcoded — moving hosts only means changing this value.
APP_URL=
# NEXT_PUBLIC_APP_URL=

# --- Admin + platform ownership ---------------------------------------------
# Bootstrap admin. The seed creates/promotes this account ONLY while no
# platform owner exists; after an ownership transfer it never re-promotes or
# renames anyone. ADMIN_PASSWORD (>= 8 chars, SECRET) is applied only while
# the account has no password.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: which admin becomes the platform owner on first start (defaults
# to ADMIN_EMAIL, else the oldest admin). Ignored once an owner exists —
# later changes go through Admin → Ownership.
# PLATFORM_OWNER_EMAIL=
# Hours an ownership transfer stays open (1–168, default 72).
# OWNERSHIP_TRANSFER_TTL_HOURS=72

# --- AI providers -------------------------------------------------------------
# Admins pick provider + model per task in Admin → AI Settings; keys saved
# there are AES-256-GCM encrypted in `ai_provider_credentials`. A key saved in
# the panel takes precedence; the env key is used when the panel has none.
# Encryption secret for panel-stored keys (>= 16 chars). SECRET.
AI_KEYS_ENCRYPTION_SECRET=
# During a rotation: the old secret, so existing keys still decrypt.
# AI_KEYS_ENCRYPTION_SECRET_PREVIOUS=
# Provider ids: openrouter | openai | anthropic | groq | google | custom
# (gemini = voice/Live only). Default provider and optional per-task override:
# AI_PROVIDER_<TASK> with TASK = ADMISSIONS | ESSAY | GENERAL | SEARCH | DOCUMENT_ANALYSIS | VISA
# AI_PROVIDER_DEFAULT=
# AI_PROVIDER_ESSAY=
# Explicit fallback when the chosen provider fails (off unless set):
# AI_PROVIDER_FALLBACK=
# Comma-separated providers that must never be used:
# AI_PROVIDERS_DISABLED=
# Keys (SECRET) + optional model overrides — set only the ones you use.
# Budget-store circuit breaker (ms). After a failed budget/usage read, further
# reads are skipped for this long and paid calls stay refused without touching
# the database again. Set 0 to disable the breaker.
# AI_BUDGET_OUTAGE_BACKOFF_MS=15000
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Only declare this when the configured Groq organization is on Groq's $0 Free plan.
# During a budget-store outage this declaration permits at most 20 requests/minute per app process.
# GROQ_API_PLAN=free
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# Specialized endpoints use separate model ids; a key/chat test does not verify them.
# OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free
# OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# OPENROUTER_VL_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
# OPENROUTER_DECISION_MODEL=inception/mercury-decide:free
# OPENROUTER_EVAL_MODEL=respan/span-01-lite:free
# Remote embeddings default to disabled. The free NVIDIA trial endpoints disclose input logging,
# and the VL card says not for production/business-critical use. Free IDs stay blocked; select a
# reviewed non-free model first, then set true only after an operator approves its data handling.
# OPENROUTER_ALLOW_REMOTE_EMBEDDINGS=false
# OPENAI_API_KEY=
# OPENAI_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# GOOGLE_AI_API_KEY=
# GOOGLE_AI_MODEL=
# Any OpenAI-compatible endpoint (self-hosted / local / other vendor):
# AI_CUSTOM_BASE_URL=
# AI_CUSTOM_API_KEY=
# AI_CUSTOM_MODEL=
# Extra capabilities to declare for it, comma-separated (text is implied):
# AI_CUSTOM_CAPABILITIES=structured,tools
# Visa Speaking Assistant voice (Gemini Live):
# GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=
# GEMINI_LIVE_API_VERSION=
# OpenRouter attribution headers (default: APP_URL / "ScholarBridge"):
# OPENROUTER_SITE_URL=
# OPENROUTER_APP_NAME=

# --- Research agent: optional web-search fallback -------------------------------
# RESEARCH_SEARCH_ENDPOINT=
# RESEARCH_SEARCH_API_KEY=

# --- Telegram bot + Mini App ------------------------------------------------------
# Easiest: leave empty and paste the token in Admin → Telegram bot (stored
# encrypted). A token saved in the panel takes precedence over this one. SECRET.
# Recommended in production anyway: the panel token lives in the database, so a
# database outage would otherwise make the bot unable to read its own token and
# it would go silent. With this variable set, /id and /start keep working even
# when app_config cannot be read.
# TELEGRAM_BOT_TOKEN=
# Webhook secret (16–256 chars of A-Z a-z 0-9 _ -). Default: derived from
# SESSION_SECRET + bot id. SECRET.
# TELEGRAM_WEBHOOK_SECRET=
# "Connect Telegram" link lifetime, seconds (60–900, default 600).
# TELEGRAM_LINK_TTL_SECONDS=600
# Max age of the Mini App's signed initData, seconds (default 3600).
# TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
# Mini App address (https). Default: <APP_URL>/tg
# TELEGRAM_MINI_APP_URL=
# Dev/tests only: point the bot at the local mock (node scripts/telegram-mock.mjs).
# TELEGRAM_API_BASE=http://127.0.0.1:8099

# --- Telegram channel publisher (autonomous posts) ---------------------------------
# Everything here is OPTIONAL: the channel is connected in Admin → Kanal, where
# the mode (off / dry run / live), the channel, the admin chat and the site URL
# are stored in the database and take effect on the next run.
#
# CHANNEL_AUTOPOST is a deploy-level CEILING, not the normal control:
#   - unset  → the admin panel decides (the panel itself starts at "off")
#   - `off`  → hard kill switch, overrides the panel entirely
#   - `dryrun` → the panel cannot reach live; everything goes to the admin chat
#   - `on`   → the panel decides freely
# Any other value is treated as `off` (a typo must never enable posting), and
# live posting additionally needs a valid channel id, admin chat and site URL.
# CHANNEL_AUTOPOST=off
# Fallbacks for the values above, used only when the admin panel has no value.
# Channel id (-100…) or @username. The bot must be an admin of that channel.
# TELEGRAM_CHANNEL_ID=
# Private chat that receives dry-run posts and failure alerts.
# TELEGRAM_ADMIN_CHAT_ID=
# Public site origin used in post links. Default: APP_URL.
# CHANNEL_SITE_URL=
# 1/true enables the "ask in the comments" CTA (and the qa post kind).
# CHANNEL_DISCUSSION_ENABLED=0
# Approval mode (`Admin → Kanal → Ulash → Mode → Approval`) needs no variable:
# every post goes to TELEGRAM_ADMIN_CHAT_ID with [Approve] [Reject] [Edit] and
# reaches the channel only after an admin presses Approve. One knob:
# how long a preview may wait before it is retired (hours, 1–48, default 6).
# CHANNEL_APPROVAL_TTL_HOURS=6
# The publisher ticks itself every CHANNEL_TICK_MINUTES (5–120, default 15) —
# no external cron needed. `CHANNEL_AUTOPILOT=off` disables the loop (for hosts
# that call /api/cron/channel instead); in `next dev` it stays off unless you
# set `CHANNEL_AUTOPILOT=on`.
# CHANNEL_TICK_MINUTES=15
# CHANNEL_AUTOPILOT=off

# --- Supabase Storage (branding uploads only) -------------------------------------
# Server-side only. Without these, logo/favicon upload answers 503 and the
# default images stay. The bucket must exist and be public-read.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BRANDING_BUCKET=LOGO
# Only for the /universities and /scholarships SSR pages when no service key:
# SUPABASE_ANON_KEY=

# --- Search engines ---------------------------------------------------------------
# Google Search Console HTML-tag token (content of the meta tag). Public.
# GOOGLE_SITE_VERIFICATION=

# --- Payments (Payme / Click) — only if you configure real merchants. SECRET. ---
# PAYME_MERCHANT_ID=        # Checkout merchant id
# PAYME_LOGIN=              # Separate Basic-auth login issued by Payme Business
# PAYME_KEY=                # Merchant key/password (PAYME_PASSWORD is an alias)
# PAYME_PASSWORD=
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_MERCHANT_USER_ID=
# CLICK_SECRET_KEY=

# --- Scheduled jobs + reminders ---------------------------------------------------
# Bearer token for GET /api/cron/refresh and /api/cron/notifications. When
# unset those endpoints refuse to run (503). SECRET.
# CRON_SECRET=
# IANA timezone deciding what "today" is for reminders (default UTC).
# REMINDER_TIMEZONE=Asia/Tashkent
# In-process reminder scheduler: on | off (default: on in production).
# NOTIFICATION_SCHEDULER=
# Hours between reminder sweeps (0.25–24, default 3).
# NOTIFICATION_SWEEP_HOURS=3

# --- Outgoing email (password reset) ------------------------------------------------
# ScholarBridge speaks SMTP itself (src/lib/mail.ts), no third-party SDK. Without
# SMTP_HOST + MAIL_FROM the app still builds, still answers
# POST /api/auth/password-reset/request with the generic 200 sentence, and
# writes one line to the server log naming the missing variables — but no link
# is ever delivered, so a student who forgot their password stays locked out.
# CREDENTIALS ARE SECRET.
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587                 # 587 = STARTTLS (default), 465 = implicit TLS
# SMTP_SECURE=0                 # 1 forces TLS from the first byte; also implied by port 465
# SMTP_USER=                     # omit for an unauthenticated relay
# SMTP_PASS=                     # your provider app password, never the mailbox password
# MAIL_FROM=ScholarBridge <no-reply@your-domain.tld>
# The reset link is built from APP_URL (above) — without it, no link is sent.

# --- Security / proxy --------------------------------------------------------------
# Proxies appending to X-Forwarded-For (default 1) and an optional header set
# by your edge that clients cannot forge (e.g. cf-connecting-ip).
# TRUSTED_PROXY_HOPS=1
# CLIENT_IP_HEADER=
# Ship the CSP in report-only mode while testing.
# CSP_REPORT_ONLY=1
