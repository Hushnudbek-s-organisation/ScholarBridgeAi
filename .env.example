# ===========================================================================
# ScholarBridgeAi — environment variables (copy to .env.local / Render env)
# NEVER commit real secrets. Keys are read server-side only.
# ===========================================================================

# --- Database (Drizzle ORM / Supabase Postgres) ---
DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- Admin seed (demo admin account) ---
ADMIN_NAME=Hushnudbek
ADMIN_EMAIL=hushnudbek@gmail.com
# Optional: the admin's sign-in password (min 6 chars). Applied once, when
# the admin account has no password yet — after that it can be changed from
# Edit Profile and the seed will NOT overwrite it. With it, the owner can
# sign in via "My account" (email + password) from any device.
ADMIN_PASSWORD=

# --- AI (chat mentor, essay studio, profile evaluation) ---
# Provider name: openrouter | openai | anthropic | groq
#
# Provider selection + API keys can also be managed from the ADMIN PANEL
# (Admin → AI Settings): values stored there override the env vars below.
# Keys saved in the panel are encrypted at rest in `ai_provider_credentials`.
#
# Encryption secret for admin-managed API keys (AES-256-GCM, >= 16 chars).
# When unset, a key is derived from DATABASE_URL — set this explicitly in
# production so keys survive a DATABASE_URL rotation.
AI_KEYS_ENCRYPTION_SECRET=
AI_PROVIDER_DEFAULT=groq
GROQ_API_KEY=
# Default: openai/gpt-oss-120b (reasoning model). llama-3.3-70b-versatile
# was removed by Groq on 2026-08-16 — do not set it, it 404s.
# Current models: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
# Other providers (optional — usable via AI_PROVIDER_* or the admin panel):
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# --- Research Agent (OpenRouter) ---
# Server-side only. The agent uses deterministic rules FIRST; OpenRouter is
# consulted ONLY for ambiguous classification and semantic extraction.
# Default model per spec: openrouter/free (do not assume an underlying model).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional — sent as HTTP-Referer / X-Title headers (OpenRouter attribution):
OPENROUTER_SITE_URL=https://scholarbridgeai-1.onrender.com
OPENROUTER_APP_NAME=ScholarBridge

# --- Visa Speaking Assistant (direct Groq API, server-side only) ---
# Get a free key: https://console.groq.com/keys
GROQ_API_KEY=
# Model for interview dialogue + analysis (default: openai/gpt-oss-120b).
# Reasoning model — reasoning tokens count against max_tokens.
# llama-3.3-70b-versatile was removed by Groq on 2026-08-16 (404).
# Current models: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# --- Research Agent: optional web-search fallback for domain discovery ---
# RESEARCH_SEARCH_ENDPOINT=
# RESEARCH_SEARCH_API_KEY=

# --- Payments (Payme / Click) — merchant keys ---
# PAYME_MERCHANT_ID=
# PAYME_KEY=
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_SECRET_KEY=

# --- Branding uploads (server-side only; the LOGO Supabase Storage bucket must exist) ---
SUPABASE_URL=https://llwrzitajdsnqzpvflnj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- App URL (used in links) ---
NEXT_PUBLIC_APP_URL=https://scholarbridgeai-1.onrender.com
