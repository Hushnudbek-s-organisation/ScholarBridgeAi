# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# Playwright artifacts
/test-results/
/playwright-report/

# misc
.DS_Store
*.pem
*.tsbuildinfo
next-env.d.ts

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# database dumps / archives
*.zip

# local audit captures (manual evidence only — not a reproducible browser test)
/screenshots/

# local embedded postgres data directory (scripts/dev-db.mjs)
/.pgdata/

# python bytecode (import scripts)
__pycache__/
*.pyc

# desktop app (Electron) — installed build output, never committed
/desktop/node_modules/
/desktop/release/
/desktop/build/*.ico
/desktop/build/*.icns

# mobile app (Capacitor) — node_modules; generated Android build output and
# signing material stay local (android/.gitignore covers app/build)
/mobile/node_modules/
/mobile/android/local.properties
/mobile/android/keystore.properties
/mobile/android/*.jks
/mobile/android/*.keystore

# desktop app self-test scratch folder
/.desktop-test-data/
